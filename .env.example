# NeuraLog Environment Variables

# LLM API Keys
NEURALOG_LLM_API_KEY=your-openai-api-key-here
# NEURALOG_LLM_API_KEY=your-anthropic-api-key-here

# LLM Provider (openai, anthropic, ollama)
NEURALOG_LLM_PROVIDER=openai
NEURALOG_LLM_MODEL=gpt-4

# For local models via Ollama
# NEURALOG_LLM_PROVIDER=ollama
# NEURALOG_LLM_MODEL=llama2
# NEURALOG_LLM_BASE_URL=http://localhost:11434/v1

# Embedding Configuration
NEURALOG_EMBEDDING_DEVICE=cpu  # cpu, cuda, mps
NEURALOG_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Verification
NEURALOG_VERIFICATION_ENABLE_VERIFICATION=true
NEURALOG_VERIFICATION_SOLVER=z3

# Logging
NEURALOG_LOG_LEVEL=INFO
NEURALOG_DEBUG=false
