# NeuraLog Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Configuration
# =============================================================================

# LLM Provider: "openai", "anthropic", "ollama", "vllm", "vllm-server"
NEURALOG_LLM_PROVIDER=vllm
NEURALOG_LLM_MODEL=Qwen/QwQ-32B-Preview

# Cloud Provider API Keys (if using openai or anthropic)
# OpenAI: Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
# Anthropic: Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Generic
NEURALOG_LLM_API_KEY=your-api-key-here

# Ollama Configuration (if using ollama)
# NEURALOG_LLM_PROVIDER=ollama
# NEURALOG_LLM_MODEL=llama2
# NEURALOG_LLM_BASE_URL=http://localhost:11434/v1

# vLLM Server Configuration (if using vllm-server)
# NEURALOG_LLM_PROVIDER=vllm-server
# NEURALOG_VLLM_BASE_URL=http://localhost:8000/v1

# =============================================================================
# HuggingFace Configuration
# =============================================================================

# HuggingFace Token (required for gated models like Llama)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here

# Cache directories
# HF_HOME=/data/huggingface
# TRANSFORMERS_CACHE=/data/huggingface/transformers

# =============================================================================
# Embedding Configuration
# =============================================================================

NEURALOG_EMBEDDING_DEVICE=cuda  # cpu, cuda, cuda:0, mps
NEURALOG_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
NEURALOG_EMBEDDING_BATCH_SIZE=128

# =============================================================================
# Ontology Configuration
# =============================================================================

NEURALOG_ONTOLOGY_REASONER=elk  # elk, hermit, pellet
NEURALOG_ONTOLOGY_ENABLE_REASONING=true

# =============================================================================
# Verification
# =============================================================================

NEURALOG_VERIFICATION_ENABLE_VERIFICATION=true
NEURALOG_VERIFICATION_SOLVER=z3
NEURALOG_VERIFICATION_SOUNDNESS_THRESHOLD=0.99

# =============================================================================
# Production Settings (vLLM)
# =============================================================================

# GPU Memory Utilization (0.85-0.95)
NEURALOG_GPU_MEMORY_UTILIZATION=0.90

# Tensor Parallel Size (number of GPUs: 1 for QwQ, 4 for DeepSeek R1)
NEURALOG_TENSOR_PARALLEL_SIZE=1

# Max Model Length (context window)
NEURALOG_MAX_MODEL_LEN=32768

# Data Type: bfloat16, float16
NEURALOG_DTYPE=bfloat16

# Prefix Caching (recommended)
NEURALOG_ENABLE_PREFIX_CACHING=true

# Batch Size
NEURALOG_MAX_NUM_SEQS=256

# =============================================================================
# Semantic Workspace
# =============================================================================

NEURALOG_USE_EPISODIC_MEMORY=true
NEURALOG_MEMORY_WINDOW=128
NEURALOG_USE_GRAPH_DYNAMICS=true

# =============================================================================
# Storage (Optional)
# =============================================================================

# Redis URL (for distributed caching)
# NEURALOG_REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Logging
# =============================================================================

NEURALOG_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
NEURALOG_DEBUG=false
